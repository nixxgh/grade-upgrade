---
---

<header class="sticky top-0 z-50 w-full border-b border-[#00D8FF]/15 bg-[#0A1142]/85 backdrop-blur-xl transition-all shadow-[0_4px_25px_rgba(26,54,141,0.3)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/logo.webp" 
        srcset="/logo-40.webp 1x, /logo.webp 2x"
        alt="Grade Upgrade" 
        width="40"
        height="40"
        decoding="async"
        class="h-10 w-10 rounded-full transition-transform group-hover:scale-105 shadow-[0_0_15px_rgba(0,216,255,0.35)]" 
      />
      <div class="flex flex-col">
        <span class="text-[10px] font-medium text-cyan-200/70 tracking-wider uppercase leading-none">Suraj Sir's & Dhiraj Sir's</span>
        <span class="font-bold text-base tracking-tight text-white leading-tight">
          Grade UPgrade
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-300">
      <a href="#methodology" class="hover:text-[#00D8FF] transition-colors">Methodology</a>
      <a href="#programs" class="hover:text-[#00D8FF] transition-colors">Programs</a>
      <a href="#results" class="hover:text-[#00D8FF] transition-colors">Results</a>
      <a href="#faq" class="hover:text-[#00D8FF] transition-colors">FAQ</a>
      <a href="#contact" class="hover:text-[#00D8FF] transition-colors">Contact</a>
    </nav>

    <!-- Right Action CTA & Mobile Hamburger -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <a 
        href="#inquire" 
        class="relative inline-flex items-center justify-center px-3.5 sm:px-4 py-1.5 text-xs sm:text-sm font-bold text-[#0A1142] bg-[#00D8FF] rounded-full hover:bg-[#38E1FF] transition-all shadow-[0_0_20px_rgba(0,216,255,0.45)] hover:shadow-[0_0_30px_rgba(0,216,255,0.8)] active:scale-95"
      >
        Book Free Demo
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn" 
        type="button"
        aria-label="Toggle Navigation Menu" 
        aria-expanded="false"
        class="md:hidden flex items-center justify-center w-9 h-9 rounded-xl border border-[#00D8FF]/20 bg-[#1A368D]/40 text-cyan-100 hover:text-white hover:border-[#00D8FF]/50 transition-colors focus:outline-none focus:ring-1 focus:ring-[#00D8FF]"
      >
        <!-- Hamburger Bars Icon -->
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <!-- Close (X) Icon -->
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Navigation Menu Drawer -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-t border-[#00D8FF]/15 bg-[#0A1142]/95 backdrop-blur-2xl px-5 py-6 shadow-2xl transition-all"
  >
    <nav class="flex flex-col gap-1 mb-6">
      <a href="#methodology" class="mobile-nav-link text-sm font-semibold text-zinc-200 hover:text-[#00D8FF] py-2.5 border-b border-[#00D8FF]/10 flex items-center justify-between transition-colors">
        <span>Teaching Methodology</span>
        <svg class="w-4 h-4 text-cyan-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a href="#programs" class="mobile-nav-link text-sm font-semibold text-zinc-200 hover:text-[#00D8FF] py-2.5 border-b border-[#00D8FF]/10 flex items-center justify-between transition-colors">
        <span>Courses & Batches</span>
        <svg class="w-4 h-4 text-cyan-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a href="#results" class="mobile-nav-link text-sm font-semibold text-zinc-200 hover:text-[#00D8FF] py-2.5 border-b border-[#00D8FF]/10 flex items-center justify-between transition-colors">
        <span>Student Results</span>
        <svg class="w-4 h-4 text-cyan-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a href="#faq" class="mobile-nav-link text-sm font-semibold text-zinc-200 hover:text-[#00D8FF] py-2.5 border-b border-[#00D8FF]/10 flex items-center justify-between transition-colors">
        <span>Frequently Asked Questions</span>
        <svg class="w-4 h-4 text-cyan-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a href="#contact" class="mobile-nav-link text-sm font-semibold text-zinc-200 hover:text-[#00D8FF] py-2.5 border-b border-[#00D8FF]/10 flex items-center justify-between transition-colors">
        <span>Campus & Map</span>
        <svg class="w-4 h-4 text-cyan-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </nav>

    <!-- Quick Direct Contact Actions in Mobile Menu -->
    <div class="grid grid-cols-2 gap-3 pt-2">
      <a 
        href="tel:+919004452071" 
        class="py-2.5 px-3 rounded-xl bg-[#1A368D]/60 hover:bg-[#1A368D] text-white font-semibold text-xs border border-[#00D8FF]/25 flex items-center justify-center gap-2"
      >
        <svg class="w-3.5 h-3.5 text-[#00D8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call Us
      </a>

      <a 
        href="https://wa.me/919004452071?text=Hi%20Grade%20UPgrade!%20I%20would%20like%20to%20inquire%20about%20admissions." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="py-2.5 px-3 rounded-xl bg-[#00D8FF] hover:bg-[#38E1FF] text-[#0A1142] font-bold text-xs shadow-[0_0_15px_rgba(0,216,255,0.35)] flex items-center justify-center gap-2"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && mobileMenu && openIcon && closeIcon) {
    const toggleMenu = () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    };

    menuBtn.addEventListener('click', toggleMenu);

    // Close menu automatically upon clicking any link
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  }
</script>
