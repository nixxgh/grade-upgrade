<!-- Persistent Floating Mobile Quick-Contact Bar (Visible only on mobile/tablet) -->
<aside
  aria-label="Quick Mobile Contact"
  class="mobile-contact-bar fixed left-3.5 right-3.5 z-40 md:hidden pointer-events-none transform-gpu will-change-transform isolate"
>
  <div class="max-w-md mx-auto pointer-events-auto rounded-2xl border border-[#00D8FF]/30 bg-[#0A1142]/95 backdrop-blur-md p-1.5 shadow-[0_8px_30px_rgba(0,0,0,0.6)] flex items-center gap-2">
    <!-- Quick Call Button -->
    <a
      href="tel:+919004452071"
      class="flex-1 py-2.5 px-2.5 sm:px-3 rounded-xl bg-[#1A368D]/70 hover:bg-[#1A368D] text-white font-bold text-[11px] sm:text-xs flex items-center justify-center gap-1.5 border border-[#00D8FF]/20 active:scale-[0.98] transition-all whitespace-nowrap"
    >
      <svg
        class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#00D8FF] shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
        />
      </svg>
      <span>Call +91 90044 52071</span>
    </a>

    <!-- Quick WhatsApp Button -->
    <a
      href="https://wa.me/919004452071?text=Hi%20Grade%20UPgrade!%20I%20would%20like%20to%20inquire%20about%20admissions."
      target="_blank"
      rel="noopener noreferrer"
      class="py-2.5 px-3.5 sm:px-4 rounded-xl bg-[#00D8FF] hover:bg-[#38E1FF] text-[#0A1142] font-extrabold text-[11px] sm:text-xs flex items-center justify-center gap-1.5 shadow-[0_0_15px_rgba(0,216,255,0.4)] active:scale-[0.98] transition-all shrink-0"
    >
      <svg
        class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current shrink-0"
        viewBox="0 0 24 24"
      >
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
</aside>

<style>
  .mobile-contact-bar {
    bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem));
    transform: translate3d(0, 0, 0);
    -webkit-transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    contain: layout paint;
  }
</style>
