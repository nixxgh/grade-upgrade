---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#00D8FF]/20 bg-gradient-to-b from-[#0A1142] via-[#070b2e] to-[#04071c] pt-14 pb-10 text-cyan-200/60 text-xs backdrop-blur-lg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-12 border-b border-[#00D8FF]/15">
      
      <!-- Brand column (5 cols) -->
      <div class="md:col-span-5 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo.png" alt="Grade Upgrade" class="h-11 w-11 rounded-full shadow-[0_0_15px_rgba(0,216,255,0.3)]" />
          <div class="flex flex-col text-left">
            <span class="text-[9px] text-cyan-200/70 uppercase tracking-wider">Suraj Sir's & Dhiraj Sir's</span>
            <span class="font-bold text-white text-base leading-tight">Grade UPgrade</span>
            <span class="text-[9px] text-[#00D8FF] tracking-wider uppercase font-semibold">It's Time to Upgrade</span>
          </div>
        </a>
        
        <p class="text-xs text-cyan-100/70 leading-relaxed max-w-sm">
          Premier academic coaching in Mumbai for ICSE, CBSE, and State Board students (Class 8–12 Science PCMB & Commerce). Concept-first methodology, doubt clearing, and regular parent progress reports.
        </p>

        <!-- Google Reviews Mini Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#1A368D]/40 border border-[#00D8FF]/20 w-fit">
          <div class="flex text-amber-400">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="text-xs font-bold text-white">4.9 / 5.0</span>
          <span class="text-[10px] text-cyan-200/70">(129+ Google Reviews)</span>
        </div>
      </div>

      <!-- Quick Navigation (3 cols) -->
      <div class="md:col-span-3 flex flex-col gap-3">
        <h4 class="text-xs font-mono font-bold text-white uppercase tracking-wider mb-1">Quick Links</h4>
        <a href="#methodology" class="hover:text-[#00D8FF] transition-colors">Teaching Methodology</a>
        <a href="#programs" class="hover:text-[#00D8FF] transition-colors">Courses & Streams</a>
        <a href="#results" class="hover:text-[#00D8FF] transition-colors">Student Results</a>
        <a href="#faq" class="hover:text-[#00D8FF] transition-colors">Frequently Asked Questions</a>
        <a href="#contact" class="hover:text-[#00D8FF] transition-colors">Location & Map</a>
        <a href="#inquire" class="hover:text-[#00D8FF] transition-colors">Book Free Demo</a>
      </div>

      <!-- Contact Details (4 cols) -->
      <div class="md:col-span-4 flex flex-col gap-3.5">
        <h4 class="text-xs font-mono font-bold text-white uppercase tracking-wider mb-1">Contact & Campus</h4>
        
        <!-- Phone -->
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-[#00D8FF] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <div>
            <span class="text-[10px] uppercase text-cyan-200/60 block">Inquiries / Admissions</span>
            <a href="tel:+919004452071" class="text-sm font-bold text-white hover:text-[#00D8FF] transition-colors">
              +91 90044 52071
            </a>
          </div>
        </div>

        <!-- Address -->
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-[#00D8FF] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <div class="text-xs text-cyan-100/75 leading-relaxed">
            <p>Shop No. 234, Gurudarshan CHSL, Opp. Municipal School,</p>
            <p>Tagore Nagar, Vikhroli East, Mumbai - 400083</p>
          </div>
        </div>

        <!-- Social links -->
        <div class="flex items-center gap-4 pt-1">
          <a 
            href="https://www.instagram.com/grade_upgrade" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hover:text-[#00D8FF] transition-colors flex items-center gap-1.5 text-pink-400 hover:text-pink-300 font-medium"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            @grade_upgrade
          </a>

          <a 
            href="https://www.google.com/maps/search/?api=1&query=GradeUPgrade+Shop+No+234+Gurudarshan+CHSL+Tagore+Nagar+Vikhroli+East+Mumbai+400083" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#00D8FF] hover:underline"
          >
            Google Maps &rarr;
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-cyan-200/50">
      <div>
        &copy; {currentYear} Grade UPgrade. All rights reserved.
      </div>
      <div class="text-[11px]">
        Designed with precision for students & parents &middot; Vikhroli, Mumbai
      </div>
    </div>
  </div>
</footer>
