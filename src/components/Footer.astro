---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#00D8FF]/20 bg-gradient-to-b from-[#0A1142] to-[#1A368D]/50 py-12 text-cyan-200/60 text-xs backdrop-blur-lg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Left brand -->
    <a href="/" class="flex items-center gap-3 group">
      <img src="/logo.png" alt="Grade Upgrade" class="h-10 w-10 rounded-full shadow-[0_0_12px_rgba(0,216,255,0.25)]" />
      <div class="flex flex-col text-left">
        <span class="text-[9px] text-cyan-200/60 uppercase tracking-wider">Suraj Sir's & Dhiraj Sir's</span>
        <span class="font-bold text-white text-sm leading-tight">Grade UPgrade</span>
        <span class="text-[9px] text-[#00D8FF] tracking-wider uppercase font-semibold">It's Time to Upgrade</span>
      </div>
    </a>

    <!-- Center Links -->
    <div class="flex flex-wrap justify-center gap-6 text-zinc-300">
      <a href="#methodology" class="hover:text-[#00D8FF] transition-colors">Methodology</a>
      <a href="#programs" class="hover:text-[#00D8FF] transition-colors">Programs</a>
      <a href="#results" class="hover:text-[#00D8FF] transition-colors">Results</a>
      <a href="#faq" class="hover:text-[#00D8FF] transition-colors">FAQ</a>
      <a 
        href="https://www.instagram.com/grade_upgrade" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hover:text-[#00D8FF] transition-colors flex items-center gap-1.5 text-pink-400 hover:text-pink-300"
      >
        <!-- Instagram icon -->
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        @grade_upgrade
      </a>
    </div>

    <!-- Right Copyright -->
    <div class="text-cyan-200/50">
      &copy; {currentYear} Grade Upgrade. All rights reserved.
    </div>
  </div>
</footer>
