---
import { getAcademicYear } from '../utils/academicYear';

const academicYear = getAcademicYear();
---

<section id="inquire" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Spotlight Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-r from-[#00D8FF]/15 via-[#1A368D]/35 to-[#00D8FF]/10 blur-[140px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative">
    <div class="rounded-3xl border border-[#00D8FF]/20 bg-gradient-to-b from-[#0d164d]/90 to-[#0A1142]/95 backdrop-blur-xl p-8 sm:p-12 md:p-16 text-center shadow-[0_15px_40px_rgba(26,54,141,0.4)]">
      <span class="inline-block text-xs font-mono font-bold px-3.5 py-1 rounded-full bg-[#1A368D]/60 text-[#00D8FF] border border-[#00D8FF]/30 mb-6 shadow-[0_0_12px_rgba(0,216,255,0.2)]">
        Admissions {academicYear} Open
      </span>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
        Ready to Upgrade Your Grades?
      </h2>

      <p class="text-cyan-100/75 text-sm sm:text-base max-w-xl mx-auto mb-10 leading-relaxed">
        Book a free consultation and trial lecture. Experience how concept-first teaching transforms your child's confidence.
      </p>

      <!-- Client-side Interactive Lead Form -->
      <form id="lead-form" class="max-w-xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8 text-left">
        <div>
          <label for="student-name" class="block text-xs font-mono text-cyan-200/70 mb-1.5 uppercase tracking-wider">Student Name</label>
          <input 
            type="text" 
            id="student-name" 
            name="student_name" 
            required 
            placeholder="e.g. Aryan Sharma" 
            class="w-full px-4 py-3 rounded-xl bg-[#0A1142]/80 border border-[#00D8FF]/20 text-white placeholder-cyan-100/30 text-sm focus:outline-none focus:border-[#00D8FF] focus:ring-1 focus:ring-[#00D8FF] transition-all"
          />
        </div>

        <div>
          <label for="phone-number" class="block text-xs font-mono text-cyan-200/70 mb-1.5 uppercase tracking-wider">Phone / WhatsApp</label>
          <input 
            type="tel" 
            id="phone-number" 
            name="phone_number" 
            required 
            placeholder="e.g. +91 98765 43210" 
            class="w-full px-4 py-3 rounded-xl bg-[#0A1142]/80 border border-[#00D8FF]/20 text-white placeholder-cyan-100/30 text-sm focus:outline-none focus:border-[#00D8FF] focus:ring-1 focus:ring-[#00D8FF] transition-all"
          />
        </div>

        <div>
          <label for="grade-level" class="block text-xs font-mono text-cyan-200/70 mb-1.5 uppercase tracking-wider">Class / Grade</label>
          <select 
            id="grade-level" 
            name="grade_level" 
            class="w-full px-4 py-3 rounded-xl bg-[#0A1142]/80 border border-[#00D8FF]/20 text-white text-sm focus:outline-none focus:border-[#00D8FF] focus:ring-1 focus:ring-[#00D8FF] transition-all appearance-none"
          >
            <option value="Class 8" class="bg-[#0A1142] text-white">Class 8</option>
            <option value="Class 9" class="bg-[#0A1142] text-white">Class 9</option>
            <option value="Class 10" class="bg-[#0A1142] text-white" selected>Class 10</option>
            <option value="Class 11" class="bg-[#0A1142] text-white">Class 11</option>
            <option value="Class 12" class="bg-[#0A1142] text-white">Class 12</option>
          </select>
        </div>

        <div>
          <label for="board-type" class="block text-xs font-mono text-cyan-200/70 mb-1.5 uppercase tracking-wider">Board</label>
          <select 
            id="board-type" 
            name="board_type" 
            class="w-full px-4 py-3 rounded-xl bg-[#0A1142]/80 border border-[#00D8FF]/20 text-white text-sm focus:outline-none focus:border-[#00D8FF] focus:ring-1 focus:ring-[#00D8FF] transition-all appearance-none"
          >
            <option value="ICSE" class="bg-[#0A1142] text-white">ICSE</option>
            <option value="CBSE" class="bg-[#0A1142] text-white" selected>CBSE</option>
            <option value="State Board" class="bg-[#0A1142] text-white">State Board</option>
          </select>
        </div>

        <div class="sm:col-span-2 pt-3">
          <button 
            type="submit" 
            class="w-full py-3.5 rounded-xl bg-[#00D8FF] text-[#0A1142] font-bold text-sm hover:bg-[#38E1FF] transition-all shadow-[0_0_25px_rgba(0,216,255,0.45)] hover:shadow-[0_0_35px_rgba(0,216,255,0.75)] active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
          >
            Submit for Free Demo Class
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </form>

      <div id="form-success" class="hidden max-w-xl mx-auto p-4 rounded-xl bg-[#00D8FF]/15 border border-[#00D8FF]/40 text-[#00D8FF] text-sm font-semibold mb-6 shadow-[0_0_20px_rgba(0,216,255,0.2)]">
        🎉 Inquiry received! We will reach out via WhatsApp / call shortly to schedule your trial class.
      </div>

      <!-- Quick WhatsApp Alternative -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-xs text-cyan-200/60 pt-4 border-t border-[#00D8FF]/15">
        <span>Prefer instant messaging?</span>
        <a 
          href="https://wa.me/919004452071?text=Hi%20Grade%20UPgrade!%20I%20would%20like%20to%20inquire%20about%20admissions." 
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#00D8FF] font-bold hover:underline flex items-center gap-1.5"
        >
          Message Directly on WhatsApp (+91 90044 52071)
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const studentName = formData.get('student_name') as string;
      const phone = formData.get('phone_number') as string;
      const grade = formData.get('grade_level') as string;
      const board = formData.get('board_type') as string;

      // Construct direct WhatsApp message link
      const text = encodeURIComponent(`Hi Grade UPgrade! I want to book a free demo.\nStudent: ${studentName}\nPhone: ${phone}\nGrade: ${grade}\nBoard: ${board}`);
      const whatsappUrl = `https://wa.me/919004452071?text=${text}`;

      // Show success message and redirect
      form.classList.add('hidden');
      successBox.classList.remove('hidden');

      // Open WhatsApp pre-filled window
      window.open(whatsappUrl, '_blank');
    });
  }
</script>
