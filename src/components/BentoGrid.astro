---
---

<section id="methodology" class="py-20 md:py-28 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-[#00D8FF] font-semibold mb-3 block">
        The Grade Upgrade System
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">
        Engineered for Real Understanding, <br class="hidden sm:inline" />
        Not Rote Memorization.
      </h2>
      <p class="text-cyan-100/75 text-sm sm:text-base">
        Most tuitions focus on cramming answers. We focus on dismantling concepts down to first principles so exams feel effortless.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      <!-- Bento 1 (Large - 2 cols) -->
      <div class="md:col-span-2 rounded-3xl border border-[#00D8FF]/15 bg-[#0d164d]/75 backdrop-blur-xl p-8 sm:p-10 relative overflow-hidden group hover:border-[#00D8FF]/40 transition-all shadow-[0_8px_30px_rgba(26,54,141,0.25)]">
        <div class="absolute top-0 right-0 w-80 h-80 bg-[#00D8FF]/5 rounded-full blur-3xl pointer-events-none group-hover:bg-[#00D8FF]/15 transition-all"></div>
        
        <div class="w-10 h-10 rounded-xl bg-[#1A368D]/50 border border-[#00D8FF]/30 flex items-center justify-center text-[#00D8FF] mb-6 shadow-[0_0_15px_rgba(0,216,255,0.2)]">
          <svg class="w-5 h-5 text-[#00D8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 tracking-tight">
          Concept-First Pedagogy
        </h3>
        <p class="text-cyan-100/75 text-sm sm:text-base leading-relaxed max-w-xl mb-6">
          When students understand the <em>why</em> behind a mathematical formula or scientific principle, they don't have to memorize steps. They can solve tricky, unfamiliar board exam questions with natural ease.
        </p>

        <!-- Visual Micro-graphic (Code/Formula style) -->
        <div class="p-4 rounded-xl border border-[#00D8FF]/20 bg-[#0A1142]/80 font-mono text-xs text-zinc-300 space-y-1">
          <div class="flex items-center gap-2 text-zinc-400 pb-1 border-b border-[#00D8FF]/15">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#00D8FF]"></span>
            <span class="ml-1 text-[11px] text-cyan-200">standard_tuition vs grade_upgrade</span>
          </div>
          <p class="text-red-400/90">❌ Rote Learning: Memorize 50 problem types -> Panics on new questions</p>
          <p class="text-[#00D8FF] font-semibold">✓ Grade Upgrade: Master core axiom -> Solves any variation</p>
        </div>
      </div>

      <!-- Bento 2 (1 col) -->
      <div class="rounded-3xl border border-[#00D8FF]/15 bg-[#0d164d]/75 backdrop-blur-xl p-8 sm:p-10 relative overflow-hidden group hover:border-[#00D8FF]/40 transition-all flex flex-col justify-between shadow-[0_8px_30px_rgba(26,54,141,0.25)]">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#1A368D]/50 border border-[#00D8FF]/30 flex items-center justify-center text-[#00D8FF] mb-6 shadow-[0_0_15px_rgba(0,216,255,0.2)]">
            <svg class="w-5 h-5 text-[#00D8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2 tracking-tight">
            Small, Focused Batches
          </h3>
          <p class="text-cyan-100/75 text-sm leading-relaxed">
            No overcrowded lecture halls with 80+ students where your child is just a roll number. Every student is recognized, engaged, and personally monitored.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#00D8FF]/15 flex items-center justify-between text-xs text-cyan-100/60">
          <span>Individual Attention</span>
          <span class="text-[#00D8FF] font-bold">100% Guaranteed</span>
        </div>
      </div>

      <!-- Bento 3 (1 col) -->
      <div class="rounded-3xl border border-[#00D8FF]/15 bg-[#0d164d]/75 backdrop-blur-xl p-8 sm:p-10 relative overflow-hidden group hover:border-[#00D8FF]/40 transition-all flex flex-col justify-between shadow-[0_8px_30px_rgba(26,54,141,0.25)]">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#1A368D]/50 border border-[#00D8FF]/30 flex items-center justify-center text-[#00D8FF] mb-6 shadow-[0_0_15px_rgba(0,216,255,0.2)]">
            <svg class="w-5 h-5 text-[#00D8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2 tracking-tight">
            Weekly Mock Testing
          </h3>
          <p class="text-cyan-100/75 text-sm leading-relaxed">
            Regular chapter-end tests modeled exactly after Board patterns. Time management practice and detailed answer paper reviews.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#00D8FF]/15 flex items-center justify-between text-xs text-cyan-100/60">
          <span>Parent Updates</span>
          <span class="text-[#00D8FF] font-bold">Weekly Progress Reports</span>
        </div>
      </div>

      <!-- Bento 4 (Large - 2 cols) -->
      <div class="md:col-span-2 rounded-3xl border border-[#00D8FF]/15 bg-[#0d164d]/75 backdrop-blur-xl p-8 sm:p-10 relative overflow-hidden group hover:border-[#00D8FF]/40 transition-all shadow-[0_8px_30px_rgba(26,54,141,0.25)]">
        <div class="w-10 h-10 rounded-xl bg-[#1A368D]/50 border border-[#00D8FF]/30 flex items-center justify-center text-[#00D8FF] mb-6 shadow-[0_0_15px_rgba(0,216,255,0.2)]">
          <svg class="w-5 h-5 text-[#00D8FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 tracking-tight">
          Uncapped 1-on-1 Doubt Clearing
        </h3>
        <p class="text-cyan-100/75 text-sm sm:text-base leading-relaxed max-w-xl mb-6">
          No student ever leaves class with unanswered questions. We run dedicated post-lecture doubt sessions and WhatsApp doubt support where students can ask without fear or hesitation.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div class="p-3 rounded-xl bg-[#1A368D]/40 border border-[#00D8FF]/20 text-xs text-white">
            <span class="block text-[#00D8FF] font-bold mb-0.5 font-mono">Zero Fear</span>
            Encouraging classroom culture
          </div>
          <div class="p-3 rounded-xl bg-[#1A368D]/40 border border-[#00D8FF]/20 text-xs text-white">
            <span class="block text-[#00D8FF] font-bold mb-0.5 font-mono">Exam Technique</span>
            Step-by-step marking schemes
          </div>
          <div class="p-3 rounded-xl bg-[#1A368D]/40 border border-[#00D8FF]/20 text-xs text-white col-span-2 sm:col-span-1">
            <span class="block text-[#00D8FF] font-bold mb-0.5 font-mono">Curated Notes</span>
            Concise formula sheets
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
