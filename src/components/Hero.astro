---
import { getAcademicYear } from '../utils/academicYear';

const academicYear = getAcademicYear();
---

<section class="relative pt-20 pb-16 md:pt-32 md:pb-24 overflow-hidden">
  <!-- Brand Radial Gradient Glow: #00D8FF and #1A368D -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[750px] h-[420px] bg-gradient-to-b from-[#00D8FF]/20 via-[#1A368D]/30 to-transparent blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[400px] h-[220px] bg-gradient-to-r from-[#00D8FF]/15 to-[#1A368D]/35 blur-[100px] pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Dynamic Pill Announcement Badge (Clickable Anchor) -->
    <a
      href="#inquire"
      class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#00D8FF]/30 bg-[#1A368D]/40 backdrop-blur-md mb-8 hover:border-[#00D8FF]/70 hover:bg-[#1A368D]/60 transition-all cursor-pointer group shadow-[0_0_15px_rgba(0,216,255,0.15)] hover:shadow-[0_0_25px_rgba(0,216,255,0.35)]"
    >
      <span class="flex h-2 w-2 rounded-full bg-[#00D8FF] animate-pulse"></span>
      <span class="text-xs sm:text-sm font-medium text-cyan-100">
        Admissions Open for{' '}
        <span class="text-[#00D8FF] font-bold">{academicYear}</span>
      </span>
      <svg
        class="w-3.5 h-3.5 text-[#00D8FF]/80 group-hover:translate-x-0.5 transition-transform"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"
        />
      </svg>
    </a>

    <!-- Main Headline with Vercel Gradient & Brand Accents -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.08] mb-6">
      <span class="block">Turn Confusion into Confidence.</span>
      <span class="block mt-2 sm:mt-3 bg-gradient-to-b from-white via-cyan-100 to-[#00D8FF] bg-clip-text text-transparent">
        It's Time to Upgrade.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-cyan-100/75 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
      Concept-first coaching, dedicated doubt-clearing sessions, and structured
      mock test series. Built for students who want real subject mastery, not
      rote memorization.
    </p>

    <!-- Dual CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="#inquire"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#00D8FF] text-[#0A1142] font-bold text-sm hover:bg-[#38E1FF] transition-all shadow-[0_0_30px_rgba(0,216,255,0.45)] hover:shadow-[0_0_40px_rgba(0,216,255,0.75)] active:scale-95 flex items-center justify-center gap-2"
      >
        Book Free Demo Class
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M14 5l7 7m0 0l-7 7m7-7H3"
          />
        </svg>
      </a>

      <a
        href="https://wa.me/919004452071?text=Hi%20Grade%20UPgrade!%20I%20would%20like%20to%20inquire%20about%20admissions."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-6 py-3.5 rounded-full border border-[#00D8FF]/25 bg-[#1A368D]/40 text-white font-medium text-sm hover:bg-[#1A368D]/70 hover:border-[#00D8FF]/50 transition-all backdrop-blur-md flex items-center justify-center gap-2.5 active:scale-95 shadow-[0_4px_20px_rgba(26,54,141,0.3)]"
      >
        <!-- WhatsApp SVG Icon -->
        <svg class="w-4 h-4 text-[#00D8FF] fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        WhatsApp Inquiry
      </a>
    </div>

    <!-- Micro Social Proof Pill -->
    <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-[#00D8FF]/20 bg-[#1A368D]/30 backdrop-blur-md">
      <div class="flex -space-x-1.5">
        <span class="w-6 h-6 rounded-full bg-[#1A368D] border border-[#00D8FF]/50 flex items-center justify-center text-[10px] font-bold text-cyan-200">
          A+
        </span>
        <span class="w-6 h-6 rounded-full bg-[#00D8FF]/30 border border-[#00D8FF]/70 flex items-center justify-center text-[10px] font-bold text-white">
          98
        </span>
        <span class="w-6 h-6 rounded-full bg-[#0A1142] border border-[#00D8FF]/40 flex items-center justify-center text-[10px] font-bold text-[#00D8FF]">
          100
        </span>
      </div>
      <p class="text-xs text-cyan-100/80 font-medium">
        Trusted by students from{' '}
        <span class="text-white font-semibold">ICSE, CBSE & State Boards</span>
      </p>
    </div>
  </div>
</section>
