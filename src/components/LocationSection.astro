---
---

<section id="contact" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Radial Glow Accents -->
  <div class="absolute top-1/3 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-r from-[#00D8FF]/10 via-[#1A368D]/30 to-transparent blur-[130px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 right-10 w-[500px] h-[300px] bg-gradient-to-l from-[#00D8FF]/10 via-[#1A368D]/20 to-transparent blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 md:mb-18">
      <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold px-3.5 py-1 rounded-full bg-[#1A368D]/60 text-[#00D8FF] border border-[#00D8FF]/30 mb-4 shadow-[0_0_12px_rgba(0,216,255,0.2)]">
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>
        CAMPUS & CONTACT
      </span>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
        Visit Us or Reach Out Today
      </h2>

      <p class="text-cyan-100/75 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Drop by our primary coaching centre in Tagore Nagar, Vikhroli East, or
        contact our faculty directly for counseling, batch timings, and demo
        lectures.
      </p>
    </div>

    <!-- Main Grid: Contact Details (Left) + Google Map Embed (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Left Info Column (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        <!-- Google Business Profile Rating Card -->
        <div class="p-5 rounded-2xl border border-[#00D8FF]/25 bg-gradient-to-br from-[#0d164d]/90 to-[#0A1142]/95 backdrop-blur-md shadow-[0_4px_25px_rgba(26,54,141,0.35)]">
          <div class="flex items-center justify-between gap-3 mb-2.5">
            <div class="flex items-center gap-2">
              <!-- Google icon -->
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                />
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                />
                <path
                  fill="#FBBC05"
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                />
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                />
              </svg>
              <span class="text-xs font-bold text-white uppercase tracking-wider">
                Google Business Profile
              </span>
            </div>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30">
              Verified
            </span>
          </div>

          <div class="flex items-baseline gap-3">
            <span class="text-3xl font-extrabold text-white">4.9</span>
            <div class="flex items-center text-amber-400">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="text-xs text-cyan-200/70 font-medium">
              129+ Google Reviews
            </span>
          </div>
          <p class="text-xs text-cyan-100/60 mt-1.5">
            Top-rated coaching center in Vikhroli, Mumbai for ICSE, CBSE & State
            Board students.
          </p>
        </div>

        <!-- Main Campus Address Card -->
        <div class="p-6 rounded-2xl border border-[#00D8FF]/20 bg-gradient-to-b from-[#0d164d]/80 to-[#0A1142]/90 backdrop-blur-md">
          <div class="flex items-center gap-2 mb-3">
            <span class="flex h-2 w-2 rounded-full bg-[#00D8FF]"></span>
            <h3 class="text-sm font-bold text-[#00D8FF] uppercase tracking-wider">
              Main Campus & Office
            </h3>
          </div>

          <h4 class="text-lg font-bold text-white mb-2">
            Tagore Nagar, Vikhroli East
          </h4>

          <p class="text-xs sm:text-sm text-cyan-100/80 leading-relaxed mb-4">
            Group No 1, Shop No. 234, Gurudarshan CHSL, Opp. Municipal School,
            Tagore Nagar, Vikhroli East, Mumbai, Maharashtra 400083
          </p>

          <div class="text-xs text-cyan-200/60 flex items-center gap-2 mb-5">
            <svg
              class="w-4 h-4 text-[#00D8FF] shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span>
              Landmark: Near Sandesh College / Purshottam Kangutkar Chowk
            </span>
          </div>

          <a
            href="https://www.google.com/maps/search/?api=1&query=GradeUPgrade+Shop+No+234+Gurudarshan+CHSL+Tagore+Nagar+Vikhroli+East+Mumbai+400083"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#1A368D]/50 hover:bg-[#1A368D] text-xs font-semibold text-cyan-100 border border-[#00D8FF]/30 hover:border-[#00D8FF] transition-all group"
          >
            Open in Google Maps
            <svg
              class="w-3.5 h-3.5 text-[#00D8FF] group-hover:translate-x-0.5 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        </div>

        <!-- Direct Contact & Phone Card -->
        <div class="p-6 rounded-2xl border border-[#00D8FF]/20 bg-gradient-to-b from-[#0d164d]/80 to-[#0A1142]/90 backdrop-blur-md flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <svg
                class="w-4 h-4 text-[#00D8FF]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
              <h3 class="text-sm font-bold text-[#00D8FF] uppercase tracking-wider">
                Direct Contact & Inquiries
              </h3>
            </div>

            <!-- Primary Phone -->
            <div class="mb-4">
              <span class="text-xs text-cyan-200/60 block mb-1">
                Official Contact / WhatsApp
              </span>
              <a
                href="tel:+919004452071"
                class="text-xl sm:text-2xl font-extrabold text-white hover:text-[#00D8FF] transition-colors flex items-center gap-2"
              >
                +91 90044 52071
              </a>
            </div>

            <!-- Operating Hours -->
            <div class="flex items-center gap-2 text-xs text-cyan-100/70 mb-5">
              <svg
                class="w-3.5 h-3.5 text-emerald-400 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span>
                <strong>Hours:</strong> Open Daily (Mon – Sun) &middot; Closes
                10:00 PM
              </span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#00D8FF]/15">
            <a
              href="tel:+919004452071"
              class="py-2.5 px-4 rounded-xl bg-[#1A368D]/60 hover:bg-[#1A368D] text-white font-semibold text-xs transition-all border border-[#00D8FF]/25 hover:border-[#00D8FF] flex items-center justify-center gap-2"
            >
              <svg
                class="w-3.5 h-3.5 text-[#00D8FF]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
              Call Now
            </a>

            <a
              href="https://wa.me/919004452071?text=Hi%20Grade%20UPgrade!%20I%20would%20like%20to%20inquire%20about%20admissions."
              target="_blank"
              rel="noopener noreferrer"
              class="py-2.5 px-4 rounded-xl bg-[#00D8FF] hover:bg-[#38E1FF] text-[#0A1142] font-bold text-xs transition-all shadow-[0_0_15px_rgba(0,216,255,0.35)] hover:shadow-[0_0_25px_rgba(0,216,255,0.6)] flex items-center justify-center gap-2"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
              </svg>
              WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Right Map Column (7 cols) -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="relative w-full h-full min-h-[420px] sm:min-h-[500px] rounded-3xl overflow-hidden border border-[#00D8FF]/30 bg-[#0A1142] shadow-[0_12px_45px_rgba(26,54,141,0.5)] group">
          <!-- Google Maps Embed Iframe -->
          <iframe
            src="https://maps.google.com/maps?q=GradeUPgrade%2C+Shop+No.+234%2C+Gurudarshan+CHSL%2C+Tagore+Nagar%2C+Vikhroli+East%2C+Mumbai%2C+Maharashtra+400083&t=&z=15&ie=UTF8&iwloc=&output=embed"
            title="GradeUPgrade Google Maps Location"
            width="100%"
            height="100%"
            class="w-full h-full min-h-[420px] sm:min-h-[500px] border-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>

          <!-- Floating Map Card Info Overlay -->
          <div class="absolute bottom-4 left-4 right-4 sm:right-auto sm:max-w-xs p-4 rounded-2xl bg-[#0A1142]/90 backdrop-blur-xl border border-[#00D8FF]/30 shadow-[0_8px_30px_rgba(0,0,0,0.6)] pointer-events-auto transition-transform">
            <div class="flex items-center gap-2 mb-1">
              <span class="flex h-2 w-2 rounded-full bg-[#00D8FF] animate-ping"></span>
              <span class="font-bold text-white text-xs">
                GradeUPgrade Coaching
              </span>
            </div>
            <p class="text-[11px] text-cyan-100/75 leading-tight mb-2.5">
              Tagore Nagar, Vikhroli East, Mumbai - 400083
            </p>
            <a
              href="https://www.google.com/maps/search/?api=1&query=GradeUPgrade+Shop+No+234+Gurudarshan+CHSL+Tagore+Nagar+Vikhroli+East+Mumbai+400083"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11px] font-bold text-[#00D8FF] hover:underline flex items-center gap-1"
            >
              Get Directions on Phone &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
