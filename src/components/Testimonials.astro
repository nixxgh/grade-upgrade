---
const reviews = [
  {
    quote:
      'Before joining Grade Upgrade, I used to dread Physics and Maths derivations. The concept-first approach changed everything. I ended up scoring 96% in my 10th Board exams!',
    student: 'Aarav S.',
    tag: 'Class 10 ICSE • 96% in Boards',
    highlight: 'Scored 96% in Boards',
  },
  {
    quote:
      'The individual doubt clearing made all the difference. Complex Physics, Chemistry, and Biology concepts were explained with first principles until I was completely exam-ready.',
    student: 'Riya M.',
    tag: 'Class 12 CBSE • 95% in Science (PCMB)',
    highlight: '95% in Science Stream',
  },
  {
    quote:
      'Accountancy and Economics balance sheets used to be confusing, but Suraj Sir and Dhiraj Sir made every financial statement intuitive. Scored 94% in my board finals!',
    student: 'Kunal D.',
    tag: 'Class 12 • 94% in Commerce',
    highlight: '94% in Commerce Stream',
  },
  {
    quote:
      'Having access to the dedicated student app to monitor daily attendance and test marks, combined with direct WhatsApp feedback from Suraj Sir & Dhiraj Sir, gives me complete peace of mind.',
    student: 'Sanjay K. (Parent)',
    tag: 'Parent of Class 9 Student',
    highlight: 'Jumped from 68% to 89%',
  },
];
---

<section id="results" class="py-20 md:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-[#00D8FF] font-semibold mb-3 block">
        Proven Outcomes
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">
        Real Transformations. <br class="hidden sm:inline" />
        Documented Results.
      </h2>
      <p class="text-cyan-100/75 text-sm sm:text-base">
        Hear directly from students and parents across Class 10, Science (PCMB),
        and Commerce who upgraded their confidence.
      </p>
    </div>

    <!-- Cards (4 columns) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {reviews.map((r) => (
        <div class="rounded-3xl border border-[#00D8FF]/15 bg-[#0d164d]/75 backdrop-blur-xl p-8 flex flex-col justify-between hover:border-[#00D8FF]/40 transition-all relative shadow-[0_8px_30px_rgba(26,54,141,0.25)]">
          <div>
            <!-- Star rating -->
            <div class="flex items-center gap-1 text-[#00D8FF] mb-4">
              {[...Array(5)].map(() => (
                <svg
                  class="w-4 h-4 fill-current drop-shadow-[0_0_8px_rgba(0,216,255,0.4)]"
                  viewBox="0 0 20 20"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Quote -->
            <p class="text-cyan-100/90 text-sm sm:text-base leading-relaxed mb-6 italic">
              "{r.quote}"
            </p>
          </div>

          <div class="pt-4 border-t border-[#00D8FF]/15 flex items-center justify-between">
            <div>
              <span class="font-bold text-white text-sm block">
                {r.student}
              </span>
              <span class="text-xs text-cyan-200/60">{r.tag}</span>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-full bg-[#00D8FF]/10 text-[#00D8FF] border border-[#00D8FF]/30 font-semibold shadow-[0_0_10px_rgba(0,216,255,0.15)]">
              {r.highlight}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
